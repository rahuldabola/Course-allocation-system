# ---- Core --------------------------------------------------------------
# development | production (production refuses to start without a real JWT_SECRET)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/allocation
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---- Auth --------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Optional bootstrap admin, created/updated on every start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo mode: seeds sample data into an empty DB and creates the public demo
# accounts admin@demo.edu / viewer@demo.edu (password: demo1234).
DEMO_MODE=true

# ---- AI assistant --------------------------------------------------------
# auto | gemini | ollama | none. "auto" = Gemini if GEMINI_API_KEY is set,
# otherwise the assistant answers the built-in report questions only.
LLM_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Rate limits (requests per minute) -----------------------------------
LOGIN_RATE_LIMIT=10
ASSISTANT_RATE_LIMIT=20
